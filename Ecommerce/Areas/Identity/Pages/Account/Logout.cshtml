@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

 
    <h1 class="text-center mx-auto m-4">@ViewData["Title"]</h1>
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <form class="form-inline m-2 text-center " asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="nav-link mx-auto text-center mb-4 btn btn-primary text-white">Click here to Logout</button>
            </form>
        }
        else
        {
            <p class="text-center mx-auto ">You have successfully logged out of the application.</p>
        }
    }
 
    s